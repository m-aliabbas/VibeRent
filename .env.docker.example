# Copy this file to .env.docker and replace every CHANGE_ME value.
# Use an alphanumeric PostgreSQL password so it can be used in POSTGRES_URL
# without URL encoding. Keep POSTGRES_PASSWORD and POSTGRES_URL synchronized.
POSTGRES_DB=viberent
POSTGRES_USER=viberent
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_ALPHANUMERIC_PASSWORD
POSTGRES_URL=postgresql://viberent:CHANGE_ME_RANDOM_ALPHANUMERIC_PASSWORD@postgres:5432/viberent

APP_PORT=3000
BETTER_AUTH_URL=https://rent.example.com
BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_TRUSTED_ORIGINS=https://rent.example.com

# Required for production account verification, password reset, and invites.
RESEND_API_KEY=CHANGE_ME
AUTH_EMAIL_FROM=VibeRent <auth@example.com>
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Optional integrations.
OPENAI_API_KEY=
