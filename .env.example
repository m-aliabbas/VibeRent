DATABASE_URL=.data/viberent.db
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Required in production for verification, password reset, and invitations.
RESEND_API_KEY=
AUTH_EMAIL_FROM=VibeRent <auth@example.com>
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Optional local-only bootstrap account used by `npm run db:seed`.
SEED_AUTH_EMAIL=
SEED_AUTH_PASSWORD=

# Desktop runtime. Keep disabled for normal web development.
VIBERENT_DESKTOP=0
VIBERENT_LAN_ENABLED=false
VIBERENT_DATA_DIR=
PRIVATE_FILE_STORAGE_ROOT=
BACKUP_ROOT=
DATABASE_MAINTENANCE_MODE=false

# Firebase-backed desktop licensing. The endpoint returns an RS256-signed JWT;
# only the public verification key is included in the desktop installer.
LICENSE_ENFORCEMENT=false
LICENSE_ENDPOINT_URL=
LICENSE_PUBLIC_KEY_BASE64=
LICENSE_APPLICATION_ID=viberent
LICENSE_AUDIENCE=viberent-desktop
LICENSE_CACHE_PATH=

# Google OAuth Desktop client. The Drive scope is limited to files created by VibeRent.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:4321/api/v1/backups/google-drive/callback
GOOGLE_DRIVE_SESSION_PATH=

# Automatic backup defaults.
BACKUP_HOUR=12
BACKUP_RETENTION_DAYS=7
