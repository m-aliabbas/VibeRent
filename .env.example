DATABASE_URL=/absolute/path/to/viberent.db
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Required in production for verification, password reset, and invitations.
RESEND_API_KEY=
AUTH_EMAIL_FROM=VibeRent <auth@example.com>

# Optional local-only bootstrap account used by `npm run db:seed`.
SEED_AUTH_EMAIL=
SEED_AUTH_PASSWORD=
