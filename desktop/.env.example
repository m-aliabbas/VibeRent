VIBERENT_DESKTOP=1
VIBERENT_LAN_ENABLED=false
LICENSE_ENFORCEMENT=true
LICENSE_APPLICATION_ID=viberent
FIREBASE_CREDENTIALS_ENC_PATH=k1.json.enc
FIREBASE_CREDENTIALS_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_LICENSE_COLLECTION=viberent_licenses
LICENSE_AUTO_REGISTER=true

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=
AUTH_EMAIL_FROM=VibeRent <auth@example.com>
AUTH_REQUIRE_EMAIL_VERIFICATION=true

GOOGLE_DRIVE_CLIENT_CONFIG_ENC_PATH=g1.json.enc
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:4321/api/v1/backups/google-drive/callback

BACKUP_HOUR=12
BACKUP_RETENTION_DAYS=7
