VIBERENT_DESKTOP=1
VIBERENT_LAN_ENABLED=false
LICENSE_ENFORCEMENT=true
LICENSE_ENDPOINT_URL=https://REGION-PROJECT.cloudfunctions.net/viberentLicense
LICENSE_PUBLIC_KEY_BASE64=BASE64_ENCODED_RSA_PUBLIC_KEY_PEM
LICENSE_APPLICATION_ID=viberent
LICENSE_AUDIENCE=viberent-desktop

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=
AUTH_EMAIL_FROM=VibeRent <auth@example.com>
AUTH_REQUIRE_EMAIL_VERIFICATION=true

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:4321/api/v1/backups/google-drive/callback

BACKUP_HOUR=12
BACKUP_RETENTION_DAYS=7
