{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Permissions required by the VibeRent desktop shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "bin/next-server",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
