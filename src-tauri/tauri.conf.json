{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeRent",
  "version": "1.0.4",
  "identifier": "com.vibeexe.viberent",
  "build": {
    "beforeBuildCommand": "npm run build && npm run desktop:prepare",
    "devUrl": "http://localhost:3000",
    "frontendDist": "static"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Local car-rental operations",
    "longDescription": "VibeRent desktop car-rental operations and fleet management",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [
      "../.next/standalone/**/*",
      "bin/.env"
    ],
    "externalBin": [
      "bin/next-server"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VibeRent",
        "width": 1360,
        "height": 860,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4322 ws://127.0.0.1:4322; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:4322; font-src 'self' data:;"
    }
  }
}
